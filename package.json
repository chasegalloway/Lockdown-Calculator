{
  "name": "lockdown-calculator",
  "version": "1.3.0",
  "description": "Teacher-controlled Desmos calculator with remote management",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder --win --mac"
  },
  "keywords": [
    "electron",
    "desmos",
    "calculator"
  ],
  "author": "Chase Galloway",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.6.2",
    "express": "^4.18.2",
    "socket.io": "^4.6.1"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.chasegalloway.lockdown-calculator",
    "productName": "Lockdown Calculator",
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "KeyBlocker.exe",
      "KeyBlocker.exe.manifest",
      "KeyBlocker"
    ],
    "files": [
      "main.js",
      "server.js",
      "*.html",
      "icon.png",
      "icon.ico",
      "KeyBlocker.exe",
      "KeyBlocker.exe.manifest",
      "KeyBlocker",
      "app.manifest",
      "node_modules/**/*"
    ],
    "win": {
      "requestedExecutionLevel": "requireAdministrator",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        "portable"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "perMachine": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 110,
          "y": 150,
          "type": "file"
        },
        {
          "x": 240,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "chasegalloway",
      "repo": "Lockdown-Calculator",
      "releaseType": "release"
    }
  }
}
